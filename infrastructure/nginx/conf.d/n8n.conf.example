# flows.useairin.id — reverse proxy for the hosted n8n agent builder.
#
# Copy to n8n.conf (drop the .example) on the VPS once a TLS cert exists for the
# subdomain, then reload nginx. n8n needs WebSocket upgrade for the editor + long
# read timeouts for workflow executions.
#
# Get a cert first, e.g.:
#   certbot certonly --webroot -w /var/www/certbot -d flows.useairin.id

upstream n8n_upstream {
    server n8n:5678;
}

server {
    listen 80;
    server_name flows.useairin.id;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name flows.useairin.id;

    ssl_certificate     /etc/letsencrypt/live/flows.useairin.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/flows.useairin.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Editor uploads / large workflow payloads.
    client_max_body_size 32m;

    location / {
        proxy_pass http://n8n_upstream;
        proxy_http_version 1.1;

        # WebSocket (push) support for the editor.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Workflow executions can run for a while.
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
