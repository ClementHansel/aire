{
  "name": "@aire/branch-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "On-prem Branch Bridge Agent: LAN camera/IoT discovery, RTSP->HLS relay, and MQTT bridge for the AIRE car-wash SaaS.",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
