diff --git a/scripts/add-dev-ssh-key.sh b/scripts/add-dev-ssh-key.sh
new file mode 100755
index 0000000..48b8269
--- /dev/null
+++ b/scripts/add-dev-ssh-key.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# Usage: ./scripts/add-dev-ssh-key.sh "ssh-ed25519 AAAA... comment" [airedev|ubuntu]
+set -euo pipefail
+KEY="${1:-}"
+TARGET_USER="${2:-airedev}"
+
+if [ -z "$KEY" ]; then
+  echo "Usage: $0 \"<public-key-line>\" [airedev|ubuntu]"
+  exit 1
+fi
+
+if [[ ! "$KEY" =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2) ]]; then
+  echo "Error: invalid public key format"
+  exit 1
+fi
+
+if [ "$TARGET_USER" != "airedev" ] && [ "$TARGET_USER" != "ubuntu" ]; then
+  echo "Error: user must be airedev or ubuntu"
+  exit 1
+fi
+
+AUTH_FILE="/home/$TARGET_USER/.ssh/authorized_keys"
+sudo mkdir -p "/home/$TARGET_USER/.ssh"
+if sudo grep -qxF "$KEY" "$AUTH_FILE" 2>/dev/null; then
+  echo "Key already exists for $TARGET_USER"
+  exit 0
+fi
+echo "$KEY" | sudo tee -a "$AUTH_FILE" >/dev/null
+sudo chmod 600 "$AUTH_FILE"
+sudo chown -R "$TARGET_USER:$TARGET_USER" "/home/$TARGET_USER/.ssh"
+echo "Added key for $TARGET_USER ($(echo "$KEY" | awk "{print \$NF}"))"
diff --git a/scripts/enable-ssl.sh b/scripts/enable-ssl.sh
new file mode 100755
index 0000000..1d5e71c
--- /dev/null
+++ b/scripts/enable-ssl.sh
@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+set -euo pipefail
+APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
+DOMAIN=useairin.xyz
+VPS_IP=$(curl -s ifconfig.me)
+
+cd "$APP_DIR"
+
+echo "Checking DNS for $DOMAIN -> $VPS_IP"
+RESOLVED=$(dig +short "$DOMAIN" A @8.8.8.8 | head -1)
+if [ "$RESOLVED" != "$VPS_IP" ]; then
+  echo "ERROR: $DOMAIN resolves to '${RESOLVED:-<none>}', expected $VPS_IP"
+  echo "Fix DNS at your registrar first:"
+  echo "  A   @    -> $VPS_IP"
+  echo "  A   www  -> $VPS_IP"
+  exit 1
+fi
+
+echo "Requesting Let's Encrypt certificate..."
+sudo certbot certonly --webroot \
+  -w /var/www/certbot \
+  -d "$DOMAIN" \
+  -d "www.$DOMAIN" \
+  --email "admin@$DOMAIN" \
+  --agree-tos \
+  --no-eff-email \
+  --non-interactive
+
+# Enable HTTPS nginx config
+if [ -f infrastructure/nginx/conf.d/ssl.conf.disabled ]; then
+  mv infrastructure/nginx/conf.d/ssl.conf.disabled infrastructure/nginx/conf.d/ssl.conf
+fi
+
+# HTTP: only ACME + redirect to HTTPS for domain
+cat > infrastructure/nginx/conf.d/default.conf <<'NGINX'
+server {
+    listen 80;
+    server_name useairin.xyz www.useairin.xyz;
+
+    location /.well-known/acme-challenge/ {
+        root /var/www/certbot;
+    }
+
+    location /health {
+        access_log off;
+        return 200 'OK';
+        add_header Content-Type text/plain;
+    }
+
+    location / {
+        return 301 https://$host$request_uri;
+    }
+}
+
+server {
+    listen 80 default_server;
+    server_name _;
+
+    location /health {
+        access_log off;
+        return 200 'OK';
+        add_header Content-Type text/plain;
+    }
+
+    location / {
+        proxy_pass http://frontend;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+    }
+}
+NGINX
+
+sudo docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d nginx
+echo "SSL enabled! Test: https://$DOMAIN/health"
