# ─── Dependencies ──────────────────────────────────────────────────
node_modules/
# pnpm's content-addressable store. Was accidentally committed on the production
# VPS's branch (71 MB / ~2900 blobs), which made a routine git divergence look
# like a 3771-file, 1M-line conflict. NOTE: gitignore has no trailing comments —
# `#` only starts a comment at the beginning of a line, so this must stay above
# the pattern, not beside it.
.pnpm-store/

# ─── Build Outputs ────────────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ─── Environment & Secrets ────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Kiro (AI agent workspace state) ─────────────────────────────
.kiro/

# ─── IDE & Editor ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS Generated ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Test & Coverage ──────────────────────────────────────────────
coverage/
.pytest_cache/
__pycache__/
*.pyc
*.pyo

# ─── Docker ───────────────────────────────────────────────────────
docker-compose.override.yml

# ─── Infrastructure Secrets ───────────────────────────────────────
infrastructure/nginx/ssl/*.pem
infrastructure/nginx/ssl/*.key
infrastructure/nginx/ssl/*.crt

# ─── Logs ─────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Misc ─────────────────────────────────────────────────────────
*.tgz
*.gz
.turbo/
.vercel/
.cache/
vps_reference.md

# ─── Local scratch / scripts (never commit) ───────────────────────
tmp_*
*.tmp
scratch/
