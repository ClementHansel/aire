# =============================================================================
# AIRE Operations Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# General
NODE_ENV=development
DOMAIN=localhost

# =============================================================================
# Ports (change if defaults conflict with your system)
# =============================================================================
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_PORT=4000
FRONTEND_PORT=3000
ALPR_PORT=5000
IOT_GATEWAY_PORT=4002
AI_SERVICE_PORT=4003
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MQTT_PORT=1883
MQTT_WS_PORT=9883

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=aire
POSTGRES_USER=aire
POSTGRES_PASSWORD=aire_secret

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=aire_redis_secret

# =============================================================================
# MinIO (Object Storage)
# =============================================================================
MINIO_ROOT_USER=aire_minio
MINIO_ROOT_PASSWORD=aire_minio_secret
MINIO_BUCKET=aire-storage

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=change_me_in_production_use_a_strong_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Payment Gateway — SINGLE SOURCE OF CONFIG
# =============================================================================
# Select the active gateway: xendit | midtrans | stripe
PAYMENT_PROVIDER=xendit
#
# The active provider reads <PROVIDER>_API_KEY and <PROVIDER>_WEBHOOK_SECRET.
# Set the key to "mock" to run the full QRIS flow in sandbox mode (real DB,
# real order/status transitions, simulated gateway). Swap "mock" for the real
# secret to go fully live — no code changes, this is the only place to update.
#
# Sandbox: auto-confirms a QRIS charge after this delay (ms) to simulate the
# customer scanning and paying. Ignored once a real key is set.
PAYMENT_SANDBOX_CONFIRM_DELAY_MS=6000

# Xendit (active by default)
XENDIT_API_KEY=mock
XENDIT_WEBHOOK_SECRET=mock_webhook_secret

# Midtrans
MIDTRANS_API_KEY=
MIDTRANS_WEBHOOK_SECRET=
MIDTRANS_IS_PRODUCTION=false

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# WhatsApp Business API
# =============================================================================
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# =============================================================================
# AI / LLM Service
# =============================================================================
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
OLLAMA_URL=http://host.docker.internal:11434

# =============================================================================
# ALPR Configuration
# =============================================================================
ALPR_CONFIDENCE_HIGH=0.9
ALPR_CONFIDENCE_LOW=0.5

# =============================================================================
# Frontend (public env vars)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=http://localhost
