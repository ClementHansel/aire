# =============================================================================
# AIRE Operations Platform - Environment Configuration (LOCAL / DEV template)
# =============================================================================
# Copy this file to .env for local development:
#     cp .env.example .env
# For a production VPS use .env.prod.example instead.
#
# The local .env in this repo remaps every host port into a +50000 range so the
# stack coexists with anything already bound to the standard ports — mirror that
# here if you hit "port already allocated".

# General
NODE_ENV=development
DOMAIN=localhost
TZ=Asia/Jakarta

# =============================================================================
# Host ports (what the containers publish on YOUR machine)
# =============================================================================
# nginx (the single local entry point → http://localhost:${HTTP_PORT})
HTTP_PORT=58090
# App + data services (all bound to 127.0.0.1)
BACKEND_PORT=54000
FRONTEND_PORT=53000
IOT_GATEWAY_PORT=54002
POSTGRES_PORT=55432
REDIS_PORT=56379
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
MQTT_PORT=51883
MQTT_WS_PORT=59883
WAHA_PORT=53001
N8N_PORT=55678
# Demo-only RTSP server (docker compose --profile demo)
DEMO_RTSP_PORT=8554

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=aire
POSTGRES_USER=aire
POSTGRES_PASSWORD=aire_secret

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=aire_redis_secret

# =============================================================================
# MinIO (Object Storage — branding logos, membership-card backgrounds)
# =============================================================================
MINIO_ROOT_USER=aire_minio
MINIO_ROOT_PASSWORD=aire_minio_secret
MINIO_BUCKET=aire-storage

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=change_me_in_production_use_a_strong_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Payment Gateway — SINGLE SOURCE OF CONFIG
# =============================================================================
# Select the active gateway: xendit | midtrans | stripe
PAYMENT_PROVIDER=xendit
#
# The active provider reads <PROVIDER>_API_KEY and <PROVIDER>_WEBHOOK_SECRET.
# Set the key to "mock" to run the full QRIS flow in sandbox mode (real DB,
# real order/status transitions, simulated gateway). Swap "mock" for the real
# secret to go fully live — no code changes, this is the only place to update.
#
# Sandbox: auto-confirms a QRIS charge after this delay (ms) to simulate the
# customer scanning and paying. Ignored once a real key is set.
PAYMENT_SANDBOX_CONFIRM_DELAY_MS=6000

# Xendit (active by default)
XENDIT_API_KEY=mock
XENDIT_WEBHOOK_SECRET=mock_webhook_secret

# Midtrans
MIDTRANS_API_KEY=
MIDTRANS_WEBHOOK_SECRET=
MIDTRANS_IS_PRODUCTION=false

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# WhatsApp Gateway (WAHA self-host — the AI agent channel)
# WAHA_API_KEY must be identical on the waha container and the backend, or WAHA
# rejects every /api call with 401. Use a long random string in production.
# =============================================================================
WAHA_PORT=53001
WAHA_URL=http://waha:3000
WAHA_API_KEY=aire_waha_local_key
KAPSO_URL=https://app.kapso.ai/api/v1

# Simulation bypass for testing WITHOUT a real WhatsApp number.
# When true: outbound sends are captured in the wa_mock_outbox table (Conversation
# Log → "Mock outbox") instead of hitting WAHA/Kapso, and status/QR report
# "connected". Exercises the whole pipeline (webhook → tenant resolve → daily cap
# → n8n/built-in AI → log → send). The dev overlay defaults this ON.
# MUST be false (or unset) in production.
WAHA_MOCK=true

# =============================================================================
# AI / LLM Service
# Per-tenant LLM keys live in the DB (tenants.settings). These are only the
# platform-level fallback / defaults.
# =============================================================================
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
OLLAMA_URL=http://host.docker.internal:11434

# =============================================================================
# n8n (hosted drag-and-drop agent builder)
# =============================================================================
# Persisted — credentials/workflows are encrypted with this. MUST be a stable
# random string (regenerating it orphans existing credentials).
N8N_ENCRYPTION_KEY=local_test_n8n_encryption_key_change_me
N8N_HOST=localhost
N8N_PROTOCOL=http
# N8N_PATH=/flows/    # set on the VPS for subpath hosting behind nginx
N8N_PUBLIC_URL=http://localhost:55678

# =============================================================================
# Internal service wiring (rarely need to change)
# =============================================================================
# Base URL n8n uses to call the AIRE bridge back (internal docker network).
BRIDGE_CALLBACK_BASE=http://backend:4000
# Where the frontend server proxies API calls (internal docker network).
BACKEND_ORIGIN=http://backend:4000

# =============================================================================
# Frontend (public env vars)
# =============================================================================
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=

# =============================================================================
# Branch Bridge agent (docker-compose.bridge.yml — local SIMULATE only)
# In production the bridge runs at the tenant's physical branch, not the VPS.
# =============================================================================
AIRE_BRIDGE_TOKEN=
AIRE_SIMULATE=true
