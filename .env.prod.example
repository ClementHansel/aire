# =============================================================================
# AIRE Operations Platform - PRODUCTION Environment (VPS template)
# =============================================================================
# On the VPS:  cp .env.prod.example .env   then fill in every "CHANGE_ME".
# Deploy with: scripts/deploy-vps.sh  (uses docker-compose.yml + docker-compose.prod.yml)
#
# Generate strong secrets, e.g.:  openssl rand -hex 32
#
# NOTE: host ports are intentionally left at their standard values here. In prod
# nginx is the only public listener (80/443); every other service stays on
# 127.0.0.1 at its default port, so you rarely need to touch the *_PORT vars.

# General
NODE_ENV=production
DOMAIN=app.useairin.id
TZ=Asia/Jakarta

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=aire
POSTGRES_USER=aire
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# =============================================================================
# MinIO (Object Storage)
# =============================================================================
MINIO_ROOT_USER=aire_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=aire-storage

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Payment Gateway — set the REAL secret to go live (leave "mock" for sandbox)
# =============================================================================
PAYMENT_PROVIDER=xendit
PAYMENT_SANDBOX_CONFIRM_DELAY_MS=6000
XENDIT_API_KEY=mock
XENDIT_WEBHOOK_SECRET=mock_webhook_secret
MIDTRANS_API_KEY=
MIDTRANS_WEBHOOK_SECRET=
MIDTRANS_IS_PRODUCTION=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# WhatsApp Gateway (WAHA). MUST be a long random string, identical here and
# (derived) on the waha container. MUST run with WAHA_MOCK=false in production.
# =============================================================================
WAHA_URL=http://waha:3000
WAHA_API_KEY=CHANGE_ME_long_random_waha_key
KAPSO_URL=https://app.kapso.ai/api/v1
# CRITICAL: false in production so real WhatsApp messages flow through WAHA.
WAHA_MOCK=false

# =============================================================================
# AI / LLM (platform fallback; per-tenant keys live in the DB)
# =============================================================================
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# =============================================================================
# n8n — served on the /flows/ subpath of the main domain (behind nginx TLS).
# =============================================================================
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
N8N_HOST=app.useairin.id
N8N_PROTOCOL=https
N8N_PATH=/flows/
N8N_PUBLIC_URL=https://app.useairin.id/flows

# =============================================================================
# Internal service wiring
# =============================================================================
BRIDGE_CALLBACK_BASE=http://backend:4000
BACKEND_ORIGIN=http://backend:4000

# =============================================================================
# Frontend (public env vars). API/WS go through nginx on the same origin.
# =============================================================================
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=
